        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:note ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:reported_tool_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:output_storage ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:runtime_env ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:purpose_detail ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:roadmap_note ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:batch_capable ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:ValidationStatus ;
