        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:validation_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:roadmap_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:reported_vendor ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^egid:USE-\\d{6}$" ] ) ] ) ] ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:purpose_class ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:user_count_raw ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:license_type ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
