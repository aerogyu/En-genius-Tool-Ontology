# 자동 생성 — 직접 고치지 말 것. 원본: schema/engenius_tool.yaml, 명령: python -m engenius_onto schema
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eg: <http://en-genius.local/onto/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eg:Feed a owl:Class ;
    rdfs:label "Feed" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom eg:ToolUsage ;
            owl:onProperty eg:consumer ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:ToolUsage ;
            owl:onProperty eg:supplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:ManualBasis ;
            owl:onProperty eg:manual_basis ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:TransferMethod ;
            owl:onProperty eg:transfer ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:consumer ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:matched_extensions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:manual_basis ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:supplier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:to_io ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:IOSpec ;
            owl:onProperty eg:to_io ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:DataCategory ;
            owl:onProperty eg:matched_category ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:FeedConfidence ;
            owl:onProperty eg:confidence ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:matched_category ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:from_io ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:IOSpec ;
            owl:onProperty eg:from_io ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty eg:matched_extensions ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^egid:FEED-[0-9a-f]{10}$" ] ) ] ) ] ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:grade ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:StartGrade ;
            owl:onProperty eg:grade ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty eg:manual ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:manual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty eg:declared ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:declared ],
        eg:Derived ;
    skos:definition "(파생) 규칙으로 계산한 공급 연결 — 출력 명세 from_io 와 입력 명세 to_io 의 분류가 같고 정규화 확장자가 겹칠 때 (docs/02 7.1). 매번 전체 재계산하며 derived 그래프에만 있다." ;
    skos:inScheme eg: .

rdfs:label rdfs:label "label" ;
    skos:definition "사람이 읽는 이름. RDF 에서는 @ko 언어 태그를 붙인다." ;
    skos:inScheme eg: .

skos:altLabel a owl:AnnotationProperty ;
    rdfs:label "alt_labels" ;
    skos:definition "조사에서 나온 변형 표기들 (CQ10)." ;
    skos:inScheme eg: .

skos:prefLabel a owl:AnnotationProperty ;
    rdfs:label "pref_label" ;
    skos:definition "대표 이름." ;
    skos:inScheme eg: .

eg:AirgapSupport a rdfs:Datatype ;
    rdfs:label "AirgapSupport" ;
    eg:form_list "폐쇄망구동" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "가능" "부분 가능(비고 기재)" "불가" "모름" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '폐쇄망구동' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "가능",
        "모름",
        "부분 가능(비고 기재)",
        "불가" .

eg:AuthMethod a rdfs:Datatype ;
    rdfs:label "AuthMethod" ;
    eg:form_list "인증방식" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "없음" "사내 SSO" "자체 계정" "라이선스 서버" "모름" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '인증방식' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "라이선스 서버",
        "모름",
        "사내 SSO",
        "없음",
        "자체 계정" .

eg:AutomationInterface a rdfs:Datatype ;
    rdfs:label "AutomationInterface" ;
    eg:form_list "자동화IF" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "없음" "CLI 인자" "내장 스크립팅" "REST API" "COM·OLE" "SDK·라이브러리" "파일 폴링" "모름" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '자동화IF' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "CLI 인자",
        "COM·OLE",
        "REST API",
        "SDK·라이브러리",
        "내장 스크립팅",
        "모름",
        "없음",
        "파일 폴링" .

eg:BatchCapability a rdfs:Datatype ;
    rdfs:label "BatchCapability" ;
    eg:form_list "배치실행" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "가능" "불가" "모름" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '배치실행' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "가능",
        "모름",
        "불가" .

eg:DataNature a rdfs:Datatype ;
    rdfs:label "DataNature" ;
    eg:form_list "데이터성격" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "서술형 문서" "수치·표" "3D·2D 형상" "이미지" "코드·스크립트" "혼합" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '데이터성격' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "3D·2D 형상",
        "서술형 문서",
        "수치·표",
        "이미지",
        "코드·스크립트",
        "혼합" .

eg:Derived a owl:Class ;
    rdfs:label "Derived" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty prov:wasDerivedFrom ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:rule_version ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty prov:generatedAtTime ] ;
    skos:definition "규칙으로 계산한 파생 노드의 provenance 묶음 (docs/02 8장). derived 그래프에만 있다." ;
    skos:inScheme eg: .

eg:DevPhase a rdfs:Datatype ;
    rdfs:label "DevPhase" ;
    eg:form_list "사용단계" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "전 단계" "개념설계" "기본설계" "상세설계" "개념~기본" "기본~상세" "상세~시험" "시험·인증 이후" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '사용단계' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "개념~기본",
        "개념설계",
        "기본~상세",
        "기본설계",
        "상세~시험",
        "상세설계",
        "시험·인증 이후",
        "전 단계" .

eg:EntityStatus a rdfs:Datatype ;
    rdfs:label "EntityStatus" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "활성" "통합됨" "폐기" ) ] ;
    skos:definition "수명주기 상태 — 삭제 대신 전이 (상위 스키마 v0.2 §6, docs/01 원칙 9)." ;
    skos:inScheme eg: ;
    linkml:permissible_values "통합됨",
        "폐기",
        "활성" .

eg:FeedConfidence a rdfs:Datatype ;
    rdfs:label "FeedConfidence" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "낮음" "보통" ) ] ;
    skos:definition "공급 연결 신뢰도 (docs/02 7.1)." ;
    skos:inScheme eg: ;
    linkml:permissible_values "낮음",
        "보통" .

eg:FormatStandard a rdfs:Datatype ;
    rdfs:label "FormatStandard" ;
    eg:form_list "포맷표준성" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "국제·업계 표준" "사내 표준 포맷" "SW 전용(바이너리)" "모름" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '포맷표준성' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "SW 전용(바이너리)",
        "국제·업계 표준",
        "모름",
        "사내 표준 포맷" .

eg:HeadlessCapability a rdfs:Datatype ;
    rdfs:label "HeadlessCapability" ;
    eg:form_list "가능불가모름" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "가능" "불가" "모름" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '가능불가모름' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "가능",
        "모름",
        "불가" .

eg:IODirection a rdfs:Datatype ;
    rdfs:label "IODirection" ;
    eg:form_list "방향" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "입력(소비)" "출력(생산)" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '방향' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "입력(소비)",
        "출력(생산)" .

eg:LicenseType a rdfs:Datatype ;
    rdfs:label "LicenseType" ;
    eg:form_list "라이선스형태" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "영구" "연간 구독" "플로팅(동시사용)" "노드락" "무료" "모름" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '라이선스형태' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "노드락",
        "모름",
        "무료",
        "연간 구독",
        "영구",
        "플로팅(동시사용)" .

eg:ManualBasis a rdfs:Datatype ;
    rdfs:label "ManualBasis" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "전달방법" "비고" ) ] ;
    skos:definition "수기 구간 판정 근거 (docs/02 7.3)." ;
    skos:inScheme eg: ;
    linkml:permissible_values "비고",
        "전달방법" .

eg:OperationMode a rdfs:Datatype ;
    rdfs:label "OperationMode" ;
    eg:form_list "조작방식" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "GUI 전용" "CLI 지원" "GUI+CLI" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '조작방식' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "CLI 지원",
        "GUI 전용",
        "GUI+CLI" .

eg:Priority a rdfs:Datatype ;
    rdfs:label "Priority" ;
    eg:form_list "우선순위" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "상" "중" "하" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '우선순위' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "상",
        "중",
        "하" .

eg:PurposeClass a rdfs:Datatype ;
    rdfs:label "PurposeClass" ;
    eg:form_list "용도대분류" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "설계" "해석" "시험·계측" "데이터·형상관리" "문서·협업" "프로젝트관리" "기타" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '용도대분류' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "기타",
        "데이터·형상관리",
        "문서·협업",
        "설계",
        "시험·계측",
        "프로젝트관리",
        "해석" .

eg:RuntimeEnv a rdfs:Datatype ;
    rdfs:label "RuntimeEnv" ;
    eg:form_list "실행환경" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Windows PC" "Windows 서버" "Linux 서버" "HPC 클러스터" "사내 웹" "외부 클라우드(SaaS)" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '실행환경' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "HPC 클러스터",
        "Linux 서버",
        "Windows PC",
        "Windows 서버",
        "사내 웹",
        "외부 클라우드(SaaS)" .

eg:SecurityGrade a rdfs:Datatype ;
    rdfs:label "SecurityGrade" ;
    eg:form_list "보안등급" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "L1" "L2" "L3" "L4" "L5" "미정" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '보안등급' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "미정" .

eg:StartGrade a rdfs:Datatype ;
    rdfs:label "StartGrade" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "A" "B" "C" "제외" ) ] ;
    skos:definition "착수 등급 (docs/02 7.4)." ;
    skos:inScheme eg: ;
    linkml:permissible_values "A",
        "B",
        "C",
        "제외" .

eg:StorageLocation a rdfs:Datatype ;
    rdfs:label "StorageLocation" ;
    eg:form_list "저장위치" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "PDM(ENOVIA)" "공유폴더" "전용 DB" "개인 PC" "혼재" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '저장위치' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "PDM(ENOVIA)",
        "개인 PC",
        "공유폴더",
        "전용 DB",
        "혼재" .

eg:UsageFrequency a rdfs:Datatype ;
    rdfs:label "UsageFrequency" ;
    eg:form_list "사용빈도" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "매일" "주 1회 이상" "월 1회 이상" "분기 이하" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '사용빈도' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "매일",
        "분기 이하",
        "월 1회 이상",
        "주 1회 이상" .

eg:ValidationStatus a rdfs:Datatype ;
    rdfs:label "ValidationStatus" ;
    eg:form_list "검증상태" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "완료" "진행중" "미실시" "해당없음" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '검증상태' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "미실시",
        "완료",
        "진행중",
        "해당없음" .

eg:YesNoUnknown a rdfs:Datatype ;
    rdfs:label "YesNoUnknown" ;
    eg:form_list "예아니오모름" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "예" "아니오" "모름" ) ] ;
    skos:definition "원본 양식 '선택지' 시트의 '예아니오모름' 목록." ;
    skos:inScheme eg: ;
    linkml:permissible_values "모름",
        "아니오",
        "예" .

eg:extensions a owl:DatatypeProperty ;
    rdfs:label "extensions" ;
    skos:definition "정규화한 확장자 목록 (소문자, 점·별표 제거, 별칭 적용). 연결 계산 키 ② (docs/02 6.2)." ;
    skos:inScheme eg: .

eg:feeds a owl:ObjectProperty ;
    rdfs:label "feeds" ;
    skos:definition "(파생) 이 툴사용이 데이터를 공급하는 툴사용 — Feed 의 지름길, 경로 질의(eg:feeds+)용. derived 그래프에만 있다." ;
    skos:inScheme eg: .

eg:partner_tools a owl:ObjectProperty ;
    rdfs:label "partner_tools" ;
    skos:definition "연계 SW명 중 Tool 로 해석된 것." ;
    skos:inScheme eg: .

eg:partner_unresolved a owl:DatatypeProperty ;
    rdfs:label "partner_unresolved" ;
    skos:definition "연계 SW명 중 Tool 로 해석하지 못한 이름 — 조사 누락 후보 (CQ09)." ;
    skos:inScheme eg: .

eg:rule_version a owl:DatatypeProperty ;
    rdfs:label "rule_version" ;
    skos:definition "이 파생 노드를 만든 규칙 버전 (예 feed_v1)." ;
    skos:inScheme eg: .

eg:succeeded_by a owl:ObjectProperty ;
    rdfs:label "succeeded_by" ;
    skos:definition "통폐합·분할로 이 분야를 이어받은 분야." ;
    skos:inScheme eg: .

eg:transfer a owl:DatatypeProperty ;
    rdfs:label "transfer" ;
    skos:definition "양쪽 명세의 전달 방법." ;
    skos:inScheme eg: .

prov:generatedAtTime a owl:DatatypeProperty ;
    rdfs:label "generated_at" ;
    rdfs:range xsd:dateTime ;
    skos:definition "파생 노드 생성 일시 (provenance)." ;
    skos:inScheme eg: .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "derived_from" ;
    rdfs:range eg:SurveyLoad ;
    skos:definition "파생의 근거가 된 적재 기록 (provenance)." ;
    skos:inScheme eg: .

eg:DataCategory a owl:Class ;
    rdfs:label "DataCategory" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^egid:CAT-\\d{3}$" ] ) ] ) ] ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:id ] ;
    skos:definition "데이터 분류 (SW입출력 '분류' 드롭다운 값). 연결 계산 키 ① (docs/02 7.1)." ;
    skos:inScheme eg: .

eg:Field a owl:Class ;
    rdfs:label "ResearchField" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^egid:FLD-\\d{3}$" ] ) ] ) ] ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:Field ;
            owl:onProperty eg:succeeded_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:status ] ;
    skos:definition "연구소 분야 (조직 노드, RDF 클래스 eg:Field — docs/02 용어). SW기본정보 '담당 부서' 값에서 만든다. 개명은 label 갱신, 통폐합·분할은 새 노드 + succeeded_by (상위 스키마 v0.2 §9). ID 는 레지스트리로 고정. 스키마·파이썬 이름만 ResearchField — 'Field' 는 생성되는 Pydantic 코드에서 pydantic.Field 를 덮어써 모든 클래스가 깨진다 (M1 에서 실측)." ;
    skos:exactMatch eg:ResearchField ;
    skos:inScheme eg: .

eg:IOSpec a owl:Class ;
    rdfs:label "IOSpec" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom eg:ToolUsage ;
            owl:onProperty eg:io_owner ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:FormatStandard ;
            owl:onProperty eg:format_standard ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^egid:IO-[0-9a-f]{10}$" ] ) ] ) ] ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:io_owner ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:Tool ;
            owl:onProperty eg:partner_tools ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:owner_source_key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:format_standard ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:TransferMethod ;
            owl:onProperty eg:transfer_method ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:inhouse_format ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:owner_source_key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:transfer_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:security_grade ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:DataNature ;
            owl:onProperty eg:data_nature ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty eg:inhouse_format ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:IODirection ;
            owl:onProperty eg:direction ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:data_nature ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:SecurityGrade ;
            owl:onProperty eg:security_grade ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:partner_unresolved ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[a-z0-9_+-]+$" ] ) ] ;
            owl:onProperty eg:extensions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:data_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:loaded_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:extensions_raw ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:data_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:partner_raw ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:partner_raw ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:DataCategory ;
            owl:onProperty eg:io_category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:source_row ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:storage_path ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:extensions_raw ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:storage_path ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:io_category ] ;
    skos:definition "SW입출력 1행. 한 툴사용이 받거나(입력) 내놓는(출력) 데이터 1종 — 에이전트 단계에서 MCP 함수의 입력·출력 정의가 된다 (docs/01 원칙 6)." ;
    skos:inScheme eg: .

eg:SurveyLoad a owl:Class ;
    rdfs:label "SurveyLoad" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty eg:warning_count ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:warning_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty eg:row_count ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:row_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[0-9a-f]{64}$" ] ) ] ;
            owl:onProperty eg:source_sha256 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:run_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty eg:loaded_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^egid:LOAD-\\d{8}T\\d{6}-\\d{2}$" ] ) ] ) ] ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:source_sha256 ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:run_id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:loaded_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:source_file_name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:source_file_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:excluded_row_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty eg:excluded_row_count ] ;
    skos:definition "적재 기록 1건 — 원천 조사 파일 1개를 한 번 적재한 것. 같은 실행(run_id)에서 여러 파일을 적재하면 파일마다 1건. 경로는 남기지 않는다 (파일명과 sha256 만)." ;
    skos:inScheme eg: .

eg:ToolKind a rdfs:Datatype ;
    rdfs:label "ToolKind" ;
    eg:form_list "구분" ;
