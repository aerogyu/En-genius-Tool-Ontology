eg:Tool a owl:Class ;
    rdfs:label "Tool" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^egid:TOOL-\\d{6}$" ] ) ] ) ] ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:vendor ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:Tool ;
            owl:onProperty eg:merged_into ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:vendor ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:merged_into ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:ToolKind ;
            owl:onProperty eg:kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:status ] ;
    skos:definition "제품 단위 툴 (표기 변형을 통합한 것). 예 ANSYS Fluent. 분야별 사용 기록은 ToolUsage. 통합은 정규화 키 일치일 때만 자동, 유사도 후보는 사람이 판정 (docs/02 6.1)." ;
    skos:inScheme eg: .

