        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:user_count_raw ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:DevPhase ;
            owl:onProperty eg:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:AutomationInterface ;
            owl:onProperty eg:automation_if ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:license_count ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:automation_if ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:ToolUsage ;
            owl:onProperty eg:feeds ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:user_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:BatchCapability ;
            owl:onProperty eg:batch_capable ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:YesNoUnknown ;
            owl:onProperty eg:certification_use ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:source_key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:reported_vendor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:auth_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:automation_detail ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:license_expiry ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:automation_detail ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:usage_tool ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:LicenseType ;
            owl:onProperty eg:license_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:AirgapSupport ;
            owl:onProperty eg:airgap_ok ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:PurposeClass ;
            owl:onProperty eg:purpose_class ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:source_key ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty eg:license_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:automation_wish ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:reported_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:pain_points ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:certification_use ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:pain_points ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:loaded_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:task_summary ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:operation_mode ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty eg:user_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty eg:validation_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:Priority ;
            owl:onProperty eg:priority_opinion ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:automation_wish ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:validation_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:ToolKind ;
            owl:onProperty eg:reported_kind ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:usage_field ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:OperationMode ;
            owl:onProperty eg:operation_mode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:priority_opinion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eg:source_row ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^\\d{4}-(0[1-9]|1[0-2])$" ] ) ] ;
            owl:onProperty eg:license_expiry ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:task_summary ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:AuthMethod ;
            owl:onProperty eg:auth_method ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty eg:airgap_ok ],
        [ a owl:Restriction ;
            owl:allValuesFrom eg:Field ;
            owl:onProperty eg:usage_field ] ;
    skos:definition "분야별 SW 응답 1건 = SW기본정보 1행 = SW ID 1개. 같은 툴을 여러 분야가 적으면 여러 개. 입출력(IOSpec)은 분야마다 다르므로 여기에 붙는다." ;
    skos:inScheme eg: .

eg:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "노드 식별자. 의미 없는 일련번호 또는 결정적 해시 (docs/02 4장). 예 egid:TOOL-000001" ;
    skos:inScheme eg: .

eg: a owl:Ontology ;
    rdfs:label "engenius_tool" ;
    eg:form_excluded_columns "SW기본정보|실무 문의처(선택)|인명 — 읽지도 저장하지도 않는다 (CLAUDE.md 절대 규칙 5); SW입출력|SW명(자동)|VLOOKUP 수식 열 — SW명은 SW ID 로 SW기본정보에서 찾는다" ;
    eg:form_source "reference/SW조사양식_EnGenius_v1.0.xlsx (원본 양식 — 사내 배포본은 헤더·선택지가 다를 수 있음)" ;
    dcterms:license "사내 전용 — 개발은 합성 데이터로만" ;
    dcterms:title "En-Genius 툴 온톨로지" ;
    pav:version "0.1.0" ;
    skos:definition "연구소 분야별 SW 조사(SW기본정보·SW입출력)를 담아 툴 간 데이터 연결을 계산하기 위한 스키마. 설계 기준은 docs/02_툴온톨로지_설계.md (3·4·7장). 클래스 7종: Field, Tool, ToolUsage, IOSpec, DataCategory, Feed(파생), SurveyLoad. ID 는 의미 없는 일련번호·해시(egid:TOOL-000001 등), 사람이 읽는 이름은 rdfs:label(@ko). 언어 태그(@ko)는 LinkML 이 데이터로 표현하지 못하므로 적재기(M3)가 RDF 를 만들 때 붙인다. 예약(미구현): WbsTask —uses_tool→ ToolUsage/Tool (지멘스 PoC 의 WBS Lv.6 연결)." .

